<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DominiusPlay.Desktop.ViewModels"
             xmlns:c="using:DominiusPlay.Domain.Contracts"
             x:Class="DominiusPlay.Desktop.Views.LeadsView" x:DataType="vm:LeadsViewModel">
  <Grid ColumnDefinitions="*,380" Margin="24">
    <DockPanel Grid.Column="0" Margin="0,0,16,0">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
        <TextBlock Text="Leads" Classes="h1" />
        <DockPanel>
          <ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding FilterIndex}" Width="200" Margin="8,0,0,0">
            <ComboBoxItem>Todos</ComboBoxItem>
            <ComboBoxItem>Autorizados</ComboBoxItem>
            <ComboBoxItem>Pendências (sem autorização)</ComboBoxItem>
            <ComboBoxItem>Descadastrados</ComboBoxItem>
          </ComboBox>
          <TextBox Text="{Binding Search}" Watermark="Pesquisar número, nome ou tag" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{Binding Total}" Classes="muted" /><TextBlock Text="leads" Classes="muted" /></StackPanel>
        <TextBlock Text="{Binding Info}" Classes="ok" />
        <TextBlock Text="{Binding Error}" Classes="error" />
      </StackPanel>
      <Border Classes="panel" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" IsVisible="{Binding HasChecked}" Background="{StaticResource AccentSoftBrush}" CornerRadius="8,8,0,0" Padding="12,10">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Limpar seleção" Command="{Binding ClearCheckedCommand}" />
                <TextBlock Text="{Binding CheckedText}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox Text="{Binding BulkConsentSource}" Watermark="Como esses contatos autorizaram? (obrigatório para autorizar, ex.: pediram informações no Instagram)" />
              <WrapPanel>
                <Button Classes="primary" Content="Autorizar selecionados" Command="{Binding AuthorizeCheckedCommand}" Margin="0,0,8,4" />
                <TextBox Text="{Binding BulkTag}" Watermark="Tag (ex.: iptv)" Width="140" Margin="0,0,8,4" />
                <Button Content="Remover tag" Command="{Binding RemoveTagCheckedCommand}" Margin="0,0,8,4" />
                <Button Classes="danger" Content="Excluir selecionados" Click="OnDeleteChecked" Margin="0,0,8,4" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="32,2*,1.7*,1.4*,1.4*,1.1*" Margin="12,8">
            <CheckBox Name="CheckAll" IsChecked="{Binding AllChecked}" IsThreeState="False" ToolTip.Tip="Selecionar todos os leads da lista" />
            <TextBlock Grid.Column="1" Text="Contato" Classes="muted" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="WhatsApp" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="Etapa" Classes="muted" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="Autorização" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="Tags" Classes="muted" VerticalAlignment="Center" />
          </Grid>
          <ListBox ItemsSource="{Binding Leads}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LeadCardVm">
                <Grid ColumnDefinitions="32,2*,1.7*,1.4*,1.4*,1.1*">
                  <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Phone}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Stage}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding Consent}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="{Binding Tags}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </DockPanel>

    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Autorizar em lote por tag" Classes="h2" />
            <TextBlock Text="Autoriza de uma vez todos os leads com a tag (inclusive os que não aparecem na tela). Descadastrados não são alterados." Classes="muted" TextWrapping="Wrap" />
            <TextBox Text="{Binding BulkTag}" Watermark="Tag (ex.: iptv)" />
            <TextBox Text="{Binding BulkConsentSource}" Watermark="Como esses contatos autorizaram? (ex.: pediram informações no Instagram)" TextWrapping="Wrap" />
            <Button Classes="primary" Content="Autorizar todos com esta tag" Command="{Binding AuthorizeByTagCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Importar números" Classes="h2" />
            <TextBlock Text="Basta a lista de números de WhatsApp com DDD, um por linha. Não precisa de nome: o contato aparece pelo número e a IA puxa a conversa sem usar nome. Arquivo CSV, TXT ou XLSX com uma coluna de números (com ou sem cabeçalho)." Classes="muted" TextWrapping="Wrap" />
            <TextBox Text="{Binding ImportSource}" Watermark="Origem (ex.: Feira 2026, Instagram)" />
            <TextBox Text="{Binding ImportTags}" Watermark="Tags separadas por vírgula" />
            <TextBlock Text="Autorização da lista (deixe em branco se não tiver)" Classes="muted" FontSize="12" />
            <TextBox Text="{Binding ImportConsentSource}" Watermark="Como esses números autorizaram contato? (ex.: pediram informações no Instagram)" TextWrapping="Wrap" />
            <Button Content="Escolher arquivo de números…" Click="OnPickFile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <TextBox Text="{Binding PasteText}" AcceptsReturn="True" Height="110" TextWrapping="Wrap" Watermark="Ou cole os números aqui, um por linha&#10;14 98815-9045&#10;21 99999-8888" />
            <Button Classes="primary" Content="Importar números colados" Command="{Binding ImportPasteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <TextBlock Text="{Binding ImportSummary}" TextWrapping="Wrap" FontSize="12" />
            <ItemsControl ItemsSource="{Binding Problems}" MaxHeight="160">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:ImportRowDto">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Line, StringFormat='Linha {0}:'}" Classes="muted" />
                    <TextBlock Text="{Binding RawPhone}" FontSize="12" />
                    <TextBlock Text="{Binding Message}" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Se a autorização acima ficar em branco, os números entram em Pendências e não recebem mensagens até você registrar o consentimento (LGPD e regras do WhatsApp)." Classes="muted" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Cadastro manual" Classes="h2" />
            <TextBox Text="{Binding NewPhone}" Watermark="WhatsApp com DDD" />
            <TextBox Text="{Binding NewName}" Watermark="Nome (opcional)" />
            <TextBox Text="{Binding NewSource}" Watermark="Origem" />
            <Button Content="Cadastrar lead" Command="{Binding AddManualCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Lead selecionado: autorização" Classes="h2" />
            <TextBox Text="{Binding ConsentSource}" Watermark="Origem verificável (ex.: formulário do site em 10/11)" />
            <Button Content="Registrar consentimento" Command="{Binding RegisterConsentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Classes="danger" Content="Descadastrar (não enviar mais)" Command="{Binding OptOutSelectedCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="Exportar dados do titular (LGPD)" Click="OnExportLgpd" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="Anonimizar contato (LGPD)" Click="OnAnonymizeLead" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6" />
            <Button Classes="danger" Content="Excluir lead e todos os dados (LGPD)" Click="OnDeleteLead" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Lista de bloqueio / descadastro" Classes="h2" />
            <TextBox Text="{Binding OptOutText}" AcceptsReturn="True" Height="80" Watermark="Um número por linha" />
            <Button Content="Importar lista de bloqueio" Command="{Binding ImportOptOutsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
