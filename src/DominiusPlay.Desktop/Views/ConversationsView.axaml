<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DominiusPlay.Desktop.ViewModels"
             xmlns:c="using:DominiusPlay.Domain.Contracts"
             x:Class="DominiusPlay.Desktop.Views.ConversationsView" x:DataType="vm:ConversationsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.bubble">
      <Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12,8" /><Setter Property="Margin" Value="0,4" />
      <Setter Property="MaxWidth" Value="520" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Background" Value="{StaticResource InboundBrush}" />
    </Style>
    <Style Selector="Border.bubble.out"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Background" Value="{StaticResource OutboundBrush}" /></Style>
    <Style Selector="Border.bubble.sys"><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Background" Value="#22FFFFFF" /></Style>
    <Style Selector="Border.bubble.fail"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Background" Value="#4A1E24" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="320,*,340">
    <!-- Contatos -->
    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="14" Spacing="8">
          <TextBlock Text="Conversas" Classes="h1" />
          <TextBox Text="{Binding Search}" Watermark="Pesquisar nome ou telefone" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LeadCardVm">
              <StackPanel Spacing="2" Margin="2,4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Ago}" Classes="muted" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock Text="{Binding LastMessage}" Classes="muted" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Border Classes="badge"><TextBlock Text="{Binding Mode}" FontSize="11" /></Border>
                  <Border Classes="badge" Background="#22FFFFFF"><TextBlock Text="{Binding Stage}" FontSize="11" /></Border>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Histórico -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="ASSUMIR ATENDIMENTO" Command="{Binding TakeOverCommand}" IsVisible="{Binding CanTakeOver}" />
            <Button Content="DEVOLVER PARA IA" Command="{Binding ReturnToAiCommand}" IsVisible="{Binding CanReturn}" />
            <Button Content="Sugerir resposta (IA)" Command="{Binding SuggestCommand}" IsVisible="{Binding CanReturn}" />
            <Button Content="Pausar" Command="{Binding PauseCommand}" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{Binding Detail.DisplayName, FallbackValue='Selecione uma conversa'}" Classes="h2" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Detail.PhoneFormatted}" Classes="muted" />
              <TextBlock Text="{Binding ModeText}" Classes="muted" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Info}" Classes="ok" />
          <TextBlock Text="{Binding Error}" Classes="error" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="primary" Content="Enviar" Command="{Binding SendCommand}" Margin="8,0,0,0" VerticalAlignment="Stretch" />
            <TextBox Text="{Binding Draft}" Watermark="Para responder, assuma o atendimento (a IA é pausada nesta conversa)" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" />
          </DockPanel>
        </StackPanel>
      </Border>
      <ScrollViewer Name="History" Padding="16">
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageVm">
              <Border Classes="bubble" Classes.out="{Binding IsOutbound}" Classes.sys="{Binding IsSystem}" Classes.fail="{Binding IsFailed}">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="10" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Qualificação comercial (editável) -->
    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="16" Spacing="6" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Border Classes="card" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" IsVisible="{Binding HasSuggestion}" Margin="0,0,0,6">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding SuggestionText}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="primary" Content="Aceitar" Click="OnAcceptSuggestion" />
                <Button Content="Descartar" Command="{Binding RejectSuggestionCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="Qualificação comercial" Classes="h2" />
          <TextBlock Text="{Binding StageText, StringFormat='Etapa: {0}'}" />
          <TextBlock Text="{Binding ConsentText, StringFormat='Autorização: {0}'}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="Experiência com IPTV" Classes="muted" />
          <ComboBox ItemsSource="{Binding Experiences}" SelectedIndex="{Binding QExperience}" HorizontalAlignment="Stretch" />
          <Grid ColumnDefinitions="*,8,110">
            <StackPanel><TextBlock Text="Painel utilizado" Classes="muted" /><TextBox Text="{Binding QPanel}" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Clientes ativos" Classes="muted" /><NumericUpDown Value="{Binding QClients}" Minimum="0" Maximum="1000000" FormatString="0" ShowButtonSpinner="False" /></StackPanel>
          </Grid>
          <TextBlock Text="Dor principal" Classes="muted" />
          <ComboBox ItemsSource="{Binding Pains}" SelectedIndex="{Binding QPain}" HorizontalAlignment="Stretch" />
          <Grid ColumnDefinitions="*,8,110">
            <StackPanel><TextBlock Text="Plano de interesse" Classes="muted" /><ComboBox ItemsSource="{Binding PlanCodes}" SelectedItem="{Binding QPlan}" HorizontalAlignment="Stretch" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Prioridade" Classes="muted" /><ComboBox ItemsSource="{Binding Priorities}" SelectedIndex="{Binding QPriority}" HorizontalAlignment="Stretch" /></StackPanel>
          </Grid>
          <TextBlock Text="Faixa de investimento" Classes="muted" /><TextBox Text="{Binding QInvestment}" />
          <TextBlock Text="Próxima ação" Classes="muted" /><TextBox Text="{Binding QNextAction}" />
          <TextBlock Text="Resumo da conversa" Classes="muted" /><TextBox Text="{Binding QSummary}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
          <Button Classes="primary" Content="Salvar qualificação" Command="{Binding SaveQualificationCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

          <Border Classes="card" Margin="0,8,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="Sugestão de plano (tabela aprovada)" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="{Binding RecommendationText}" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding IsSupervisor}">
            <TextBlock Text="Responsável" Classes="h2" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Atribuir" Command="{Binding AssignCommand}" Margin="6,0,0,0" />
              <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding Assignee}" PlaceholderText="Sem responsável" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="c:UserDto"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </DockPanel>
          </StackPanel>

          <TextBlock Text="Memória do lead (fatos)" Classes="h2" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding Facts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="c:FactDto">
                <StackPanel Margin="0,2">
                  <TextBlock TextWrapping="Wrap" FontSize="12"><Run Text="{Binding Key}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Value}" /></TextBlock>
                  <TextBlock Text="{Binding Source}" Classes="muted" FontSize="10" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="100,6,*">
            <TextBox Text="{Binding NewFactKey}" Watermark="assunto" />
            <TextBox Grid.Column="2" Text="{Binding NewFactValue}" Watermark="informação confirmada" />
          </Grid>
          <Button Content="Registrar informação" Command="{Binding AddFactCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
