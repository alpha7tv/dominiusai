<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DominiusPlay.Desktop.ViewModels"
             xmlns:c="using:DominiusPlay.Domain.Contracts"
            
             x:Class="DominiusPlay.Desktop.Views.DashboardView" x:DataType="vm:DashboardViewModel">
  <ScrollViewer>
    <StackPanel Margin="28" Spacing="20">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshCommand}" />
        <StackPanel>
          <TextBlock Text="Dashboard" Classes="h1" />
          <TextBlock Text="Tentativas, entregas e respostas são contadas separadamente." Classes="muted" />
        </StackPanel>
      </DockPanel>
      <TextBlock Text="{Binding Error}" Classes="error" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <UniformGrid Columns="4" IsVisible="{Binding Data, Converter={x:Static ObjectConverters.IsNotNull}}">
        <UniformGrid.Styles>
          <Style Selector="Border.kpi"><Setter Property="Margin" Value="0,0,12,12" /></Style>
          <Style Selector="TextBlock.v"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Bold" /></Style>
        </UniformGrid.Styles>
        <Border Classes="panel kpi"><StackPanel><TextBlock Classes="muted" Text="Leads cadastrados" /><TextBlock Classes="v" Text="{Binding Data.LeadsTotal}" /></StackPanel></Border>
        <Border Classes="panel kpi"><StackPanel><TextBlock Classes="muted" Text="Com autorização válida" /><TextBlock Classes="v" Foreground="{StaticResource OkBrush}" Text="{Binding Data.LeadsWithConsent}" /></StackPanel></Border>
        <Border Classes="panel kpi"><StackPanel><TextBlock Classes="muted" Text="Pendentes de autorização" /><TextBlock Classes="v" Text="{Binding Data.LeadsPendingConsent}" /></StackPanel></Border>
        <Border Classes="panel kpi"><StackPanel><TextBlock Classes="muted" Text="Contatos iniciados" /><TextBlock Classes="v" Text="{Binding Data.ContactsInitiated}" /></StackPanel></Border>
        <Border Classes="panel kpi"><StackPanel><TextBlock Classes="muted" Text="Conversas respondidas" /><TextBlock Classes="v" Text="{Binding Data.ConversationsReplied}" /></StackPanel></Border>
        <Border Classes="panel kpi"><StackPanel><TextBlock Classes="muted" Text="Mensagens enviadas" /><TextBlock Classes="v" Text="{Binding Data.MessagesSent}" /></StackPanel></Border>
        <Border Classes="panel kpi"><StackPanel><TextBlock Classes="muted" Text="Entregues / lidas" /><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="v" Text="{Binding Data.MessagesDelivered}" /><TextBlock Classes="v" Text="/" /><TextBlock Classes="v" Text="{Binding Data.MessagesRead}" /></StackPanel></StackPanel></Border>
        <Border Classes="panel kpi"><StackPanel><TextBlock Classes="muted" Text="Falhas de envio" /><TextBlock Classes="v" Foreground="{StaticResource DangerBrush}" Text="{Binding Data.MessagesFailed}" /></StackPanel></Border>
        <Border Classes="panel kpi"><StackPanel><TextBlock Classes="muted" Text="Assumidas por humanos" /><TextBlock Classes="v" Text="{Binding Data.HumanTakeovers}" /></StackPanel></Border>
        <Border Classes="panel kpi"><StackPanel><TextBlock Classes="muted" Text="Na fila de envio" /><TextBlock Classes="v" Text="{Binding Data.QueuePending}" /></StackPanel></Border>
      </UniformGrid>
      <!-- Agentes de IA: indicadores com filtros -->
      <Border Classes="panel" IsVisible="{Binding AgentsData, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{x:Static vm:DashboardViewModel.Periods}" SelectedIndex="{Binding PeriodIndex}" Width="170" />
              <ComboBox ItemsSource="{Binding AgentOptions}" SelectedItem="{Binding AgentFilter}" Width="240">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:IdOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox ItemsSource="{Binding CampaignOptions}" SelectedItem="{Binding CampaignFilter}" Width="220">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:IdOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="Agentes de IA" Classes="h2" VerticalAlignment="Center" />
          </DockPanel>
          <UniformGrid Columns="5">
            <UniformGrid.Styles>
              <Style Selector="Border.kpi"><Setter Property="Margin" Value="0,0,10,10" /><Setter Property="Padding" Value="12" /></Style>
              <Style Selector="TextBlock.v"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="Bold" /></Style>
            </UniformGrid.Styles>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Contatos importados" /><TextBlock Classes="v" Text="{Binding AgentsData.Imported}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Elegíveis p/ campanha" /><TextBlock Classes="v" Text="{Binding AgentsData.Eligible}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Campanhas ativas" /><TextBlock Classes="v" Text="{Binding AgentsData.ActiveCampaigns}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Mensagens enviadas" /><TextBlock Classes="v" Text="{Binding AgentsData.Sent}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Entregas confirmadas" /><TextBlock Classes="v" Text="{Binding AgentsData.Delivered}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Respostas recebidas" /><TextBlock Classes="v" Text="{Binding AgentsData.Replies}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Taxa de resposta (%)" /><TextBlock Classes="v" Text="{Binding AgentsData.ResponseRate}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Qualificados" /><TextBlock Classes="v" Foreground="{StaticResource OkBrush}" Text="{Binding AgentsData.Qualified}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Transferências humanas" /><TextBlock Classes="v" Text="{Binding AgentsData.Handoffs}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Propostas" /><TextBlock Classes="v" Text="{Binding AgentsData.Proposals}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Vendas" /><TextBlock Classes="v" Foreground="{StaticResource OkBrush}" Text="{Binding AgentsData.Sales}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Descadastros" /><TextBlock Classes="v" Text="{Binding AgentsData.OptOuts}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Erros operacionais" /><TextBlock Classes="v" Foreground="{StaticResource DangerBrush}" Text="{Binding AgentsData.Errors}" /></StackPanel></Border>
            <Border Classes="card kpi"><StackPanel><TextBlock Classes="muted" Text="Tokens de IA" /><TextBlock Classes="v" Text="{Binding AgentsData.AiTokens}" /></StackPanel></Border>
          </UniformGrid>
          <TextBlock Text="Conversão por campanha" FontWeight="SemiBold" />
          <TextBlock Text="Nenhuma campanha com envios no período." Classes="muted" IsVisible="{Binding !Conversions.Count}" />
          <ItemsControl ItemsSource="{Binding Conversions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="c:CampaignConversionDto">
                <Grid ColumnDefinitions="*,90,90,90,70,110,110" Margin="0,3">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Sent, StringFormat='{}{0} enviados'}" />
                  <TextBlock Grid.Column="2" Text="{Binding Replied, StringFormat='{}{0} resp.'}" />
                  <TextBlock Grid.Column="3" Text="{Binding Qualified, StringFormat='{}{0} qualif.'}" />
                  <TextBlock Grid.Column="4" Text="{Binding Sales, StringFormat='{}{0} vendas'}" />
                  <TextBlock Grid.Column="5" Text="{Binding ResponseRate, StringFormat='{}{0}% resposta'}" />
                  <TextBlock Grid.Column="6" Text="{Binding ConversionRate, StringFormat='{}{0}% conversão'}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding AgentsData.Note}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,16,*">
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Funil (colunas do Kanban)" Classes="h2" />
            <ItemsControl ItemsSource="{Binding Stages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:Stat">
                  <DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="Bold" /><TextBlock Text="{Binding Key}" /></DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Principais dores identificadas" Classes="h2" />
            <TextBlock Text="Ainda sem dados." Classes="muted" IsVisible="{Binding !Pains.Count}" />
            <ItemsControl ItemsSource="{Binding Pains}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:Stat">
                  <DockPanel Margin="0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="Bold" /><TextBlock Text="{Binding Key}" /></DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
