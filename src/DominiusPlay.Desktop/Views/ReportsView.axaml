<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DominiusPlay.Desktop.ViewModels"
             xmlns:c="using:DominiusPlay.Domain.Contracts"
             x:Class="DominiusPlay.Desktop.Views.ReportsView" x:DataType="vm:ReportsViewModel">
  <UserControl.Resources>
    <SolidColorBrush x:Key="StSent" Color="#8C96B3" />
    <SolidColorBrush x:Key="StDelivered" Color="#4C8DFF" />
    <SolidColorBrush x:Key="StRead" Color="#3CC48A" />
    <SolidColorBrush x:Key="StFailed" Color="#EF5B5B" />
    <DataTemplate x:Key="SentRowTemplate" x:DataType="vm:SentRowVm">
      <Grid ColumnDefinitions="*,280,70,80,80,70,70,80,70" Margin="0,4">
        <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Label}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Height="10">
          <Border Width="{Binding ReadWidth}" Background="{StaticResource StRead}" />
          <Border Width="{Binding DeliveredWidth}" Background="{StaticResource StDelivered}" />
          <Border Width="{Binding SentWidth}" Background="{StaticResource StSent}" />
          <Border Width="{Binding FailedWidth}" Background="{StaticResource StFailed}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Total}" FontWeight="Bold" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="3" Text="{Binding Sent}" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="4" Text="{Binding Delivered}" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="5" Text="{Binding Read}" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="6" Text="{Binding Failed}" HorizontalAlignment="Right" Foreground="{StaticResource StFailed}" />
        <TextBlock Grid.Column="7" Text="{Binding DeliveryRate}" HorizontalAlignment="Right" Classes="muted" />
        <TextBlock Grid.Column="8" Text="{Binding ReadRate}" HorizontalAlignment="Right" Classes="muted" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Periods}" SelectedIndex="{Binding Period}" Width="170" />
          <Button Content="Exportar leads (CSV)" Click="OnExportLeads" />
          <Button Content="Exportar mensagens (CSV)" Click="OnExportMessages" />
        </StackPanel>
        <TextBlock Text="Relatórios" Classes="h1" />
      </DockPanel>
      <TextBlock Text="{Binding Info}" Classes="ok" TextWrapping="Wrap" /><TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" />
      <TabControl SelectedIndex="{Binding Tab}">
        <TabItem Header="Visão geral" FontSize="16">
          <StackPanel Spacing="12" Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:Kpi">
                    <Border Classes="panel" Margin="0,0,12,0">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" Classes="muted" />
                        <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="11" IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReportSection">
                    <Border Classes="panel" Margin="0,0,12,12">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" Classes="h2" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReportRowVm">
                              <StackPanel Margin="0,3">
                                <DockPanel>
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Width="{Binding Bar}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" IsVisible="{Binding HasDetail}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
          </StackPanel>
        </TabItem>
        <TabItem Header="Mensagens enviadas" FontSize="16">
          <StackPanel Spacing="12" Margin="0,12,0,0" DataContext="{Binding Sent}" x:DataType="vm:SentMessagesReportViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Campanha" VerticalAlignment="Center" Classes="muted" />
              <ComboBox ItemsSource="{Binding CampaignOptions}" SelectedItem="{Binding Campaign}" Width="260">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="c:FilterOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Enviada por" VerticalAlignment="Center" Classes="muted" Margin="12,0,0,0" />
              <ComboBox ItemsSource="{Binding AuthorOptions}" SelectedItem="{Binding Author}" Width="260">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="c:FilterOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Classes="error" />
            <ItemsControl ItemsSource="{Binding Kpis}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:Kpi">
                  <Border Classes="panel" Margin="0,0,12,0">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" Classes="muted" />
                      <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="Bold" />
                      <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="11" IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource StSent}" /><TextBlock Text="Enviado (saiu, sem confirmação)" Classes="muted" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource StDelivered}" /><TextBlock Text="Entregue" Classes="muted" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource StRead}" /><TextBlock Text="Lido" Classes="muted" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource StFailed}" /><TextBlock Text="Falhou" Classes="muted" /></StackPanel>
              <TextBlock Text="Cada mensagem conta só no status atual: uma mensagem lida aparece em Lido, não em Entregue." Classes="muted" />
            </StackPanel>
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding PeriodTitle}" Classes="h2" />
                <ItemsControl ItemsSource="{Binding Chart}" Margin="0,0,14,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PeriodBarVm">
                      <StackPanel ToolTip.Tip="{Binding Tip}" Background="Transparent">
                        <TextBlock Text="{Binding Total}" FontSize="10" HorizontalAlignment="Center" Classes="muted" />
                        <Panel Height="140">
                          <StackPanel VerticalAlignment="Bottom" Margin="2,0" MaxWidth="28">
                            <Border Height="{Binding FailedHeight}" Background="{StaticResource StFailed}" />
                            <Border Height="{Binding SentHeight}" Background="{StaticResource StSent}" />
                            <Border Height="{Binding DeliveredHeight}" Background="{StaticResource StDelivered}" />
                            <Border Height="{Binding ReadHeight}" Background="{StaticResource StRead}" />
                          </StackPanel>
                        </Panel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Classes="muted" Margin="0,4,0,0" ClipToBounds="False" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Classes="panel">
              <StackPanel Spacing="4">
                <TextBlock Text="Por campanha" Classes="h2" />
                <Grid ColumnDefinitions="*,280,70,80,80,70,70,80,70" Margin="0,0,0,4">
                  <TextBlock Grid.Column="0" Text="Campanha" Classes="muted" />
                  <TextBlock Grid.Column="2" Text="Total" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="Enviado" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="Entregue" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="Lido" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="6" Text="Falhou" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="7" Text="% entrega" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="8" Text="% leitura" Classes="muted" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ByCampaign}" ItemTemplate="{StaticResource SentRowTemplate}" />
                <TextBlock Text="Nenhuma mensagem enviada no período." Classes="muted" IsVisible="{Binding !ByCampaign.Count}" />
              </StackPanel>
            </Border>
            <Border Classes="panel">
              <StackPanel Spacing="4">
                <TextBlock Text="Por atendente / IA" Classes="h2" />
                <Grid ColumnDefinitions="*,280,70,80,80,70,70,80,70" Margin="0,0,0,4">
                  <TextBlock Grid.Column="0" Text="Enviada por" Classes="muted" />
                  <TextBlock Grid.Column="2" Text="Total" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="Enviado" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="Entregue" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="Lido" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="6" Text="Falhou" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="7" Text="% entrega" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="8" Text="% leitura" Classes="muted" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ByAuthor}" ItemTemplate="{StaticResource SentRowTemplate}" />
                <TextBlock Text="Nenhuma mensagem enviada no período." Classes="muted" IsVisible="{Binding !ByAuthor.Count}" />
              </StackPanel>
            </Border>
            <Border Classes="panel">
              <StackPanel Spacing="4">
                <TextBlock Text="Detalhe por período" Classes="h2" />
                <Grid ColumnDefinitions="*,280,70,80,80,70,70,80,70" Margin="0,0,0,4">
                  <TextBlock Grid.Column="0" Text="Período (só com envios)" Classes="muted" />
                  <TextBlock Grid.Column="2" Text="Total" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="Enviado" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="Entregue" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="Lido" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="6" Text="Falhou" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="7" Text="% entrega" Classes="muted" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="8" Text="% leitura" Classes="muted" HorizontalAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ByPeriod}" ItemTemplate="{StaticResource SentRowTemplate}" />
                <TextBlock Text="Nenhuma mensagem enviada no período." Classes="muted" IsVisible="{Binding !ByPeriod.Count}" />
              </StackPanel>
            </Border>
            <Border Classes="panel" IsVisible="{Binding !!Failures.Count}">
              <StackPanel Spacing="6">
                <TextBlock Text="Motivos de falha" Classes="h2" />
                <ItemsControl ItemsSource="{Binding Failures}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportRowVm">
                      <StackPanel Margin="0,3">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Border Height="4" CornerRadius="2" Background="{StaticResource StFailed}" Width="{Binding Bar}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>
      </TabControl>
      <Border Classes="panel" IsVisible="{Binding IsAdmin}">
        <StackPanel Spacing="8">
          <TextBlock Text="Manutenção e LGPD (administrador)" Classes="h2" />
          <TextBlock Text="Backup: cópia completa do banco na pasta de dados do servidor (mantém os 20 mais recentes). Limpeza: remove registros técnicos antigos (eventos de webhook e fila); conversas, leads e consentimentos não são apagados. Para excluir ou exportar os dados de um titular, use a tela Leads." Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Fazer backup agora" Command="{Binding BackupCommand}" />
            <TextBlock Text="Limpar registros técnicos com mais de" VerticalAlignment="Center" Margin="16,0,0,0" />
            <NumericUpDown Value="{Binding PurgeDays}" Minimum="7" Maximum="3650" FormatString="0" Width="120" />
            <TextBlock Text="dias" VerticalAlignment="Center" />
            <Button Content="Limpar" Command="{Binding PurgeCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
