<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DominiusPlay.Desktop.ViewModels"
             x:Class="DominiusPlay.Desktop.Views.ReportsView" x:DataType="vm:ReportsViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Periods}" SelectedIndex="{Binding Period}" Width="170" />
          <Button Content="Exportar leads (CSV)" Click="OnExportLeads" />
          <Button Content="Exportar mensagens (CSV)" Click="OnExportMessages" />
        </StackPanel>
        <TextBlock Text="Relatórios" Classes="h1" />
      </DockPanel>
      <TextBlock Text="{Binding Info}" Classes="ok" TextWrapping="Wrap" /><TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Kpis}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:Kpi">
            <Border Classes="panel" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{Binding Label}" Classes="muted" />
                <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="{Binding Hint}" Classes="muted" FontSize="11" IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Sections}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReportSection">
            <Border Classes="panel" Margin="0,0,12,12">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" Classes="h2" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportRowVm">
                      <StackPanel Margin="0,3">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Width="{Binding Bar}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" IsVisible="{Binding HasDetail}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="panel" IsVisible="{Binding IsAdmin}">
        <StackPanel Spacing="8">
          <TextBlock Text="Manutenção e LGPD (administrador)" Classes="h2" />
          <TextBlock Text="Backup: cópia completa do banco na pasta de dados do servidor (mantém os 20 mais recentes). Limpeza: remove registros técnicos antigos (eventos de webhook e fila); conversas, leads e consentimentos não são apagados. Para excluir ou exportar os dados de um titular, use a tela Leads." Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Fazer backup agora" Command="{Binding BackupCommand}" />
            <TextBlock Text="Limpar registros técnicos com mais de" VerticalAlignment="Center" Margin="16,0,0,0" />
            <NumericUpDown Value="{Binding PurgeDays}" Minimum="7" Maximum="3650" FormatString="0" Width="120" />
            <TextBlock Text="dias" VerticalAlignment="Center" />
            <Button Content="Limpar" Command="{Binding PurgeCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
