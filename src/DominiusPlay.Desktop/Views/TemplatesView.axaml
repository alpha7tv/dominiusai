<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DominiusPlay.Desktop.ViewModels"
             xmlns:c="using:DominiusPlay.Domain.Contracts"
             x:Class="DominiusPlay.Desktop.Views.TemplatesView" x:DataType="vm:TemplatesViewModel">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="Biblioteca de mensagens" Classes="h1" />
      <TextBlock Text="Modelos de abordagem inicial carregados em revisão. Edição, aprovação e versionamento pela tela chegam na Fase 8." Classes="muted" />
      <TextBlock Text="{Binding Error}" Classes="error" />
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Templates}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="c:TemplateDto">
          <Border Classes="card" Margin="0,0,0,10">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Name}" Classes="h2" /><TextBlock Text="{Binding Version, StringFormat='v{0}'}" Classes="muted" /><TextBlock Text="{Binding Approval}" Classes="muted" /></StackPanel>
              <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
