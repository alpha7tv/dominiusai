<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DominiusPlay.Desktop.ViewModels"
             xmlns:c="using:DominiusPlay.Domain.Contracts"
             x:Class="DominiusPlay.Desktop.Views.CampaignsView" x:DataType="vm:CampaignsViewModel">
  <Grid ColumnDefinitions="*,420" Margin="24">
    <DockPanel Margin="0,0,16,0">
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Atualizar" Command="{Binding RefreshCommand}" />
            <Button Classes="primary" Content="+ Nova campanha" Command="{Binding NewCommand}" />
          </StackPanel>
          <TextBlock Text="Campanhas" Classes="h1" />
        </DockPanel>
        <TextBlock Text="Só recebem a abordagem leads com autorização válida, na etapa 'Primeiro contato', nunca contatados e fora da lista de bloqueio. Intervalo padrão e mínimo de 15 minutos entre abordagens, só no horário e dias escolhidos." Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Info}" Classes="ok" TextWrapping="Wrap" /><TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Campaigns}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CampaignRowVm">
            <Border Classes="card">
              <StackPanel Spacing="3">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="{Binding Name}" Classes="h2" />
                </DockPanel>
                <TextBlock Text="{Binding Schedule}" Classes="muted" />
                <TextBlock Text="{Binding Template}" Classes="muted" />
                <TextBlock Text="{Binding Numbers}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Extras}" Classes="muted" />
                <TextBlock Text="{Binding PauseReason}" Classes="error" IsVisible="{Binding HasPauseReason}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <ScrollViewer Grid.Column="1">
      <Border Classes="panel" VerticalAlignment="Top">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding FormTitle}" Classes="h2" />
          <StackPanel Spacing="6" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="Nome" Classes="muted" /><TextBox Text="{Binding Name}" />
            <TextBlock Text="Modelo de mensagem (somente aprovados)" Classes="muted" />
            <ComboBox ItemsSource="{Binding ApprovedTemplates}" SelectedItem="{Binding Template}" PlaceholderText="Aprove um modelo em Mensagens" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="c:TemplateDto"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Agente de disparo" Classes="muted" />
            <ComboBox ItemsSource="{Binding DispatchAgents}" SelectedItem="{Binding DispatchAgent}" PlaceholderText="Configuração global (sem agente)" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="c:AgentDto"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Listas de leads (marque uma ou mais; nenhuma marcada = todas)" Classes="muted" TextWrapping="Wrap" />
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" MaxHeight="170">
              <ScrollViewer>
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Batches}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ImportBatchOptionVm"><CheckBox IsChecked="{Binding IsSelected}"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></CheckBox></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Nenhuma lista importada ainda. Dê um nome à lista ao importar em Leads." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasBatches}" />
                </StackPanel>
              </ScrollViewer>
            </Border>
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel><TextBlock Text="Importados de (dd/mm/aaaa)" Classes="muted" /><TextBox Text="{Binding ImportedFrom}" Watermark="opcional" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="até (dd/mm/aaaa)" Classes="muted" /><TextBox Text="{Binding ImportedTo}" Watermark="opcional" /></StackPanel>
            </Grid>
            <TextBlock Text="Nunca envia duas vezes para o mesmo número: quem já recebeu mensagem (de qualquer campanha) fica de fora automaticamente." Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="Somente leads com estas tags (vírgula; vazio = todos autorizados)" Classes="muted" TextWrapping="Wrap" /><TextBox Text="{Binding TagFilter}" />
            <TextBlock Text="Segmento (vazio = todos)" Classes="muted" /><TextBox Text="{Binding Segment}" Watermark="ex.: Revendedor" />
            <TextBlock Text="Data de início (opcional, dd/mm/aaaa hh:mm)" Classes="muted" /><TextBox Text="{Binding StartDate}" />
            <CheckBox Content="Personalizar cada abordagem com IA (a partir do modelo aprovado)" IsChecked="{Binding AiPersonalization}" />
            <TextBlock Text="A IA só varia a redação: mantém empresa e opção SAIR, não inventa preço, link nem dados. Se falhar, vai o modelo aprovado. Desligado no modo Cloud API oficial." Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="Prompt da campanha (para a personalização)" Classes="muted" /><TextBox Text="{Binding Prompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" />
            <TextBlock Text="Acompanhamento (para quem não respondeu)" Classes="muted" />
            <ComboBox ItemsSource="{Binding FollowUpTemplates}" SelectedItem="{Binding FollowUpTemplate}" PlaceholderText="Aprove um modelo de Acompanhamento em Mensagens" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="c:TemplateDto"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Dias após a abordagem para cada etapa (ex.: 1,3,7; vazio = sem acompanhamento). Para sozinho se o contato responder." Classes="muted" TextWrapping="Wrap" />
            <TextBox Text="{Binding FollowUpDays}" />
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel><TextBlock Text="Pausar se falhas &gt; (%)" Classes="muted" /><NumericUpDown Value="{Binding MaxFailurePercent}" Minimum="1" Maximum="100" FormatString="0" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Pausar se descadastros &gt; (%)" Classes="muted" /><NumericUpDown Value="{Binding MaxOptOutPercent}" Minimum="1" Maximum="100" FormatString="0" /></StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel><TextBlock Text="Início (HH:mm)" Classes="muted" /><TextBox Text="{Binding StartTime}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Fim (HH:mm)" Classes="muted" /><TextBox Text="{Binding EndTime}" /></StackPanel>
            </Grid>
            <TextBlock Text="Dias permitidos" Classes="muted" />
            <WrapPanel>
              <CheckBox Content="Seg" IsChecked="{Binding Mon}" Margin="0,0,8,0" /><CheckBox Content="Ter" IsChecked="{Binding Tue}" Margin="0,0,8,0" />
              <CheckBox Content="Qua" IsChecked="{Binding Wed}" Margin="0,0,8,0" /><CheckBox Content="Qui" IsChecked="{Binding Thu}" Margin="0,0,8,0" />
              <CheckBox Content="Sex" IsChecked="{Binding Fri}" Margin="0,0,8,0" /><CheckBox Content="Sáb" IsChecked="{Binding Sat}" Margin="0,0,8,0" />
              <CheckBox Content="Dom" IsChecked="{Binding Sun}" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,8,*,8,*">
              <StackPanel><TextBlock Text="Máx. contatos" Classes="muted" /><NumericUpDown Value="{Binding MaxContacts}" Minimum="1" Maximum="10000" FormatString="0" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Limite/dia" Classes="muted" /><NumericUpDown Value="{Binding DailyLimit}" Minimum="1" Maximum="1000" FormatString="0" /></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="Intervalo (min)" Classes="muted" /><NumericUpDown Value="{Binding IntervalMinutes}" Minimum="15" Maximum="240" FormatString="0" /></StackPanel>
            </Grid>
            <TextBlock Text="Objetivo (interno)" Classes="muted" /><TextBox Text="{Binding Objective}" />
            <Button Content="Salvar campanha" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Controle" Classes="h2" Margin="0,8,0,0" />
          <Grid ColumnDefinitions="*,8,*">
            <Button Content="Validar" Command="{Binding ValidateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Pré-visualizar abordagens" Command="{Binding PreviewCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding Validation}" TextWrapping="Wrap" FontSize="12" />
          <ItemsControl ItemsSource="{Binding Previews}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="c:ApproachPreview">
                <Border Classes="card" Margin="0,0,0,4">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Contact}" Classes="muted" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="primary" Content="▶ Iniciar envio" Click="OnStart" IsVisible="{Binding CanStart}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Content="❚❚ Pausar" Command="{Binding PauseCommand}" IsVisible="{Binding CanPause}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Content="▶ Retomar" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Classes="danger" Content="Cancelar campanha" Click="OnCancel" IsVisible="{Binding CanCancel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
