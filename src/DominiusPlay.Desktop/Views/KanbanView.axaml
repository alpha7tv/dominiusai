<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DominiusPlay.Desktop.ViewModels"
             x:Class="DominiusPlay.Desktop.Views.KanbanView" x:DataType="vm:KanbanViewModel">
  <UserControl.Styles>
    <Style Selector="Border.bubble">
      <Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12,8" /><Setter Property="Margin" Value="0,4" />
      <Setter Property="MaxWidth" Value="460" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Background" Value="{StaticResource InboundBrush}" />
    </Style>
    <Style Selector="Border.bubble.out"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Background" Value="{StaticResource OutboundBrush}" /></Style>
    <Style Selector="Border.bubble.sys"><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="Background" Value="#22FFFFFF" /></Style>
    <Style Selector="Border.bubble.fail"><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Background" Value="#4A1E24" /></Style>
  </UserControl.Styles>
  <Panel>
  <DockPanel Margin="24">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding Filter}" Watermark="Filtrar por nome ou telefone" Width="260" />
        <Button Content="Atualizar" Command="{Binding RefreshCommand}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Dominius Play — CRM Comercial" Classes="h1" />
        <TextBlock Text="Clique no card para abrir a conversa do WhatsApp. Arraste os cards entre as colunas. 'Negócio fechado' exige confirmação comercial." Classes="muted" />
      </StackPanel>
    </DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="2">
      <TextBlock Text="{Binding Info}" Classes="ok" />
      <TextBlock Text="{Binding Error}" Classes="error" />
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Columns}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" Columns="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KanbanColumnVm">
            <Border Classes="panel" Margin="0,0,10,0" Padding="8" DragDrop.AllowDrop="True" Tag="{Binding Stage}" Name="Column">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10">
                  <Border Width="4" Height="18" CornerRadius="2" Background="{Binding Color}" Margin="0,0,8,0" />
                  <Border DockPanel.Dock="Right" Classes="badge"><TextBlock Text="{Binding Count}" FontSize="12" /></Border>
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LeadCardVm">
                        <Border Classes="card" Margin="0,0,0,8" Cursor="Hand" Tag="{Binding Id}" Name="Card">
                          <StackPanel Spacing="3">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding Ago}" Classes="muted" />
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Phone}" Classes="muted" />
                            <TextBlock Text="{Binding Plan}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Clients}" FontSize="12" IsVisible="{Binding Clients, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding Pain}" FontSize="12" TextWrapping="Wrap" Foreground="#F2B36B" IsVisible="{Binding Pain, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding LastMessage}" Classes="muted" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding NextAction}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding NextAction, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Border Classes="badge" Background="#33E0B341" IsVisible="{Binding HasSuggestion}" Margin="0,4,0,0">
                              <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SuggestionText}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <Button Content="Aceitar" FontSize="11" Padding="8,2" Tag="{Binding}" Click="OnAcceptSuggestion" />
                                  <Button Content="Descartar" FontSize="11" Padding="8,2" Tag="{Binding}" Click="OnRejectSuggestion" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,4,0,0">
                              <Border Classes="badge" Margin="0,0,4,4"><TextBlock Text="{Binding Mode}" FontSize="11" /></Border>
                              <Border Classes="badge" Margin="0,0,4,4" Background="#22FFFFFF"><TextBlock Text="{Binding Priority}" FontSize="11" /></Border>
                              <Border Classes="badge" Margin="0,0,4,4" Background="#22FFFFFF"><TextBlock Text="{Binding Owner}" FontSize="11" /></Border>
                            </WrapPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>

  <!-- Popup: conversa do WhatsApp do card clicado -->
  <Panel Name="ChatOverlay" IsVisible="{Binding Chat.IsOpen}">
    <Border Name="ChatBackdrop" Background="#B3000000" PointerPressed="OnBackdropPressed" />
    <Border Classes="panel" Width="640" Margin="0,32" HorizontalAlignment="Center" VerticalAlignment="Stretch" Padding="0"
            BoxShadow="0 12 40 0 #80000000" DataContext="{Binding Chat}" x:DataType="vm:ChatPopupViewModel">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Spacing="8">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseCommand}" ToolTip.Tip="Fechar (Esc)" Padding="10,4" VerticalAlignment="Top" Name="CloseChat" />
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" Classes="h2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted" />
                <TextBlock Text="{Binding ModeText}" Classes="muted" Foreground="{StaticResource AccentBrush}" />
              </StackPanel>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="ASSUMIR ATENDIMENTO" Command="{Binding TakeOverCommand}" IsVisible="{Binding CanTakeOver}" />
              <Button Content="DEVOLVER PARA IA" Command="{Binding ReturnToAiCommand}" IsVisible="{Binding CanReturn}" />
              <Button Content="Sugerir resposta (IA)" Command="{Binding SuggestCommand}" IsVisible="{Binding CanReturn}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Info}" Classes="ok" IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding Error}" Classes="error" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="primary" Content="Enviar" Command="{Binding SendCommand}" IsEnabled="{Binding IsHuman}" Margin="8,0,0,0" VerticalAlignment="Stretch" />
              <TextBox Name="ChatDraft" Text="{Binding Draft}" Watermark="{Binding ComposerHint}" IsEnabled="{Binding IsHuman}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="120" />
            </DockPanel>
          </StackPanel>
        </Border>
        <Panel>
          <ScrollViewer Name="ChatHistory" Padding="16">
            <ItemsControl ItemsSource="{Binding Messages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageVm">
                  <Border Classes="bubble" Classes.out="{Binding IsOutbound}" Classes.sys="{Binding IsSystem}" Classes.fail="{Binding IsFailed}">
                    <StackPanel Spacing="3">
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="10" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="Ainda não há mensagens com este contato." Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoMessages}" />
        </Panel>
      </DockPanel>
    </Border>
  </Panel>
  </Panel>
</UserControl>
