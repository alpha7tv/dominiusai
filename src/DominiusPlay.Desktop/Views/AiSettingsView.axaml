<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DominiusPlay.Desktop.ViewModels"
             x:Class="DominiusPlay.Desktop.Views.AiSettingsView" x:DataType="vm:AiSettingsViewModel">
  <Grid ColumnDefinitions="520,*" Margin="24">
    <ScrollViewer Margin="0,0,16,0">
      <StackPanel Spacing="12">
        <TextBlock Text="Configurações — Inteligência artificial" Classes="h1" />
        <TextBlock Text="{Binding Info}" Classes="ok" /><TextBlock Text="{Binding Error}" Classes="error" />
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="IA atendendo as conversas" OffContent="IA desligada (só humanos respondem)" />
            <TextBlock Text="Provedor: Anthropic (Claude)" Classes="muted" />
            <TextBlock Text="Chave de API da Anthropic" Classes="muted" />
            <TextBox Text="{Binding ApiKey}" PasswordChar="●" Watermark="sk-ant-... (deixe em branco para manter a atual)" />
            <TextBlock Text="✓ Chave salva com criptografia no servidor" Classes="ok" FontSize="12" IsVisible="{Binding HasApiKey}" />
            <TextBlock Text="Modelo do atendimento (padrão: claude-haiku-5-5, rápido e econômico)" Classes="muted" TextWrapping="Wrap" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Carregar modelos" Command="{Binding LoadModelsCommand}" Margin="8,0,0,0" />
              <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" HorizontalAlignment="Stretch" />
            </DockPanel>
            <TextBlock Text="Modelo da negociação (etapa Em negociação; padrão: claude-sonnet-5-5)" Classes="muted" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding AdvancedModel}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Nome de exibição da assistente" Classes="muted" />
            <TextBox Text="{Binding AssistantName}" />
            <Grid ColumnDefinitions="*,12,*">
              <StackPanel><TextBlock Text="Limite por resposta (tokens)" ToolTip.Tip="Inclui o raciocínio do modelo; a mensagem ao cliente continua curta" Classes="muted" /><NumericUpDown Value="{Binding MaxTokens}" Minimum="1000" Maximum="16000" Increment="500" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Espera para agrupar mensagens (s)" Classes="muted" /><NumericUpDown Value="{Binding DebounceSeconds}" Minimum="0" Maximum="120" /></StackPanel>
            </Grid>
            <TextBlock Text="Limite diário de consumo (tokens)" Classes="muted" />
            <NumericUpDown Value="{Binding DailyTokenLimit}" Minimum="0" Increment="50000" />
            <TextBlock Text="{Binding TokensUsedToday, StringFormat='Usado hoje: {0} tokens. Ao atingir o limite, as conversas vão para atendimento humano.'}" Classes="muted" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding Typing}" Content="Mostrar &quot;digitando&quot; enquanto a resposta é preparada" />
            <Button Classes="primary" Content="Salvar configurações da IA" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="12">
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="Script de atendimento" Classes="h2" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Escreva aqui como a IA deve atender: tom de voz, apresentação, produtos e ofertas, perguntas que deve fazer, respostas para objeções e quando transferir para um humano. O texto vai junto em toda resposta da IA." />
            <TextBox x:Name="ScriptBox" Text="{Binding Instructions}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" Height="340"
                     VerticalContentAlignment="Top" FontFamily="Consolas,Menlo,monospace" FontSize="13"
                     Watermark="Ex.:&#10;TOM: simpático e direto, trate por você.&#10;APRESENTAÇÃO: diga que é a Lia, assistente virtual da Dominius Play.&#10;OFERTA PRINCIPAL: comece pelo Mensalista 50 para quem está começando.&#10;OBJEÇÃO &quot;está caro&quot;: explique o custo por cliente ativo.&#10;TRANSFERIR PARA HUMANO: quando pedir teste, pagamento ou proposta formal.&#10;HORÁRIO DA EQUIPE: 9h às 21h." />
            <TextBlock Text="{Binding ScriptInfo}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Preços continuam vindo só da tela Planos. Se o script citar um valor que não está aprovado lá, a IA não usa." />
          </StackPanel>
        </Border>
        <Border Classes="panel">
          <Expander Header="Prompt de sistema (avançado)" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="É a base da IA: identidade, objetivo, regras de conversa e roteiro de diagnóstico. Já vem preenchido com o padrão do sistema. Use {nome_assistente} para o nome de exibição." />
              <TextBox x:Name="SystemPromptBox" Text="{Binding SystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" Height="300"
                       VerticalContentAlignment="Top" FontFamily="Consolas,Menlo,monospace" FontSize="12" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restaurar padrão" Command="{Binding RestoreDefaultSystemPromptCommand}" />
                <TextBlock Text="{Binding SystemPromptInfo}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
              </DockPanel>
              <Expander Header="Regras fixas do sistema (não editáveis)" HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                             Text="Sempre vão junto, depois do prompt e antes do script: identificação como assistente virtual, preços só dos planos aprovados, transferência para humano, uso das ferramentas do CRM e contatos sem nome." />
                  <SelectableTextBlock Text="{Binding FixedRules}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Expander>
        </Border>
        <Button Classes="primary" Content="Salvar script e prompt" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="Testar a assistente (simulação)" Classes="h2" />
            <TextBlock Text="Usa o script e o prompt salvos. Nada é enviado pelo WhatsApp nem salvo no CRM." Classes="muted" TextWrapping="Wrap" />
            <TextBox Text="{Binding TestMessage}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
            <Button Content="Simular resposta" Command="{Binding TestCommand}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <Border Classes="card" IsVisible="{Binding TestReply, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding TestReply}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
